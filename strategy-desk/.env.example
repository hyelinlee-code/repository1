# Exa API key — https://dashboard.exa.ai/api-keys
# Server-side only. Never prefix with NEXT_PUBLIC_: the key must not reach the browser.
EXA_API_KEY=

# Optional. Base URL for the Exa REST API.
EXA_BASE_URL=https://api.exa.ai

# Optional. Set to "1" to force the seeded demo brief even when EXA_API_KEY is present.
# Useful for offline demos and for screenshotting the UI without spending credits.
DEMO_MODE=0
